    "agents",
    "assets",
    "docs",
    "references",
    "schemas",
    "scripts",
    "src",
    "test",
    "release-files.json",
    "README.md",
    "README.en.md",
    "BENCHMARK.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "start": "node scripts/fortune-teller.mjs interactive",
    "calculate": "node scripts/fortune-teller.mjs calculate",
    "methods": "node scripts/fortune-teller.mjs methods",
    "sources": "node scripts/fortune-teller.mjs sources",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test",
    "verify": "node scripts/release-check.mjs",
    "check": "npm test && npm run doctor && npm run verify",
    "package:skill": "node scripts/package-skill.mjs"
