{
  "name": "fortune-teller",
  "version": "0.2.0",
  "description": "Result-first Chinese and Western divination Agent Skill with local, auditable calculation engines.",
  "homepage": "https://github.com/jmf-enigma/fortune-teller#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmf-enigma/fortune-teller.git"
  },
  "bugs": {
    "url": "https://github.com/jmf-enigma/fortune-teller/issues"
  },
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "fortune-teller": "scripts/fortune-teller.mjs"
