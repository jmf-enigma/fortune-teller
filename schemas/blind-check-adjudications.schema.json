{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortune-teller:schema:blind-check-adjudications:3",
  "title": "Complete criterion-level blind-check adjudications",
  "description": "Every frozen criterion must be assessed exactly once. A hypothesis outcome is deliberately absent and is derived mechanically by the scorer.",
  "type": "array",
  "minItems": 1,
  "maxItems": 5,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["hypothesis_id", "criteria"],
    "properties": {
      "hypothesis_id": { "type": "string", "pattern": "^H-0[1-5]$" },
      "criteria": {
        "type": "array",
        "minItems": 2,
        "maxItems": 15,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["criterion_id", "result", "observed_on", "source_type", "observation"],
          "properties": {
            "criterion_id": { "type": "string", "pattern": "^K-[A-Za-z0-9_-]+$" },
            "result": { "enum": ["met", "not_met", "unclear"] },
            "observed_on": { "type": "string", "format": "date" },
            "source_type": {
              "enum": ["self_report", "contemporaneous_record", "administrative_record", "third_party_record"]
            },
            "observation": { "type": "string", "minLength": 12, "maxLength": 500 }
          }
        }
      }
    }
  }
}
