{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortune-teller:schema:evidence-card:1",
  "title": "Auditable evidence card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "statement",
    "epistemic_status",
    "system",
    "profile",
    "fact_ids",
    "rule_ids",
    "calculation_certainty",
    "input_sensitivity",
    "school_stability",
    "source_status",
    "source_ids"
  ],
  "properties": {
    "claim_id": { "type": "string", "pattern": "^C-[A-Za-z0-9_-]+$" },
    "statement": { "type": "string", "minLength": 1 },
    "epistemic_status": { "enum": ["calculation_fact", "traditional_rule", "interpretation", "unresolved"] },
    "system": { "enum": ["bazi", "ziwei", "western", "tarot", "iching", "meihua"] },
    "profile": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object" }
      ]
    },
    "scope": { "type": "string", "minLength": 1 },
    "fact_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "rule_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "reasoning_summary": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "calculation_certainty": { "enum": ["high", "qualified", "unavailable"] },
    "input_sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "coverage"],
      "properties": {
        "label": { "enum": ["stable", "partly_stable", "boundary_sensitive", "unavailable"] },
        "coverage": { "type": ["string", "null"], "pattern": "^\\d+/\\d+$" }
      }
    },
    "school_stability": { "enum": ["stable", "profile_specific", "disputed", "not_assessed"] },
    "source_status": { "enum": ["verified", "engine_documented", "unavailable", "disputed"] },
    "source_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "alternative_readings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "practical_reflection": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "epistemic_status": { "const": "interpretation" } },
        "required": ["epistemic_status"]
      },
      "then": {
        "properties": {
          "rule_ids": { "type": "array", "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "epistemic_status": { "const": "unresolved" } },
        "required": ["epistemic_status"]
      },
      "then": {
        "properties": {
          "statement": {
            "pattern": "(不确定|无法判断|不能判断|尚不能判断|暂时不能判断|无法确定|不能确定|无法确认|不能确认|信息不足|证据不足|资料不足|不可判断|[Uu]ncertain|[Uu]nknown|[Uu]nresolved|[Cc]annot determine|[Cc]an't determine|[Cc]annot conclude|[Cc]an't conclude|[Ii]nsufficient information|[Ii]nsufficient evidence|[Nn]ot enough information|[Nn]ot enough evidence)"
          }
        }
      }
    }
  ]
}
