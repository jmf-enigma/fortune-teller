{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortune-teller:schema:reading-validation-payload:1",
  "title": "Fortune Teller reading validation payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["reading"],
  "properties": {
    "calculation": { "$ref": "calculation-result.schema.json" },
    "calculations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "calculation-result.schema.json" }
    },
    "reading": { "$ref": "reading.schema.json" }
  },
  "oneOf": [
    { "required": ["calculation"] },
    { "required": ["calculations"] }
  ]
}
