{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortune-teller:schema:reading-validation-payload:1",
  "title": "Fortune Teller reading validation payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["reading"],
  "properties": {
    "calculation": { "$ref": "urn:fortune-teller:schema:calculation-result:1" },
    "calculations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:fortune-teller:schema:calculation-result:1" }
    },
    "reading": { "$ref": "urn:fortune-teller:schema:reading:3" }
    ,
    "binding_options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "meaning_unavailable": { "enum": ["strict", "degrade_claim"] }
      }
    }
  },
  "oneOf": [
    { "required": ["calculation"] },
    { "required": ["calculations"] }
  ]
}
